# Apify, for LinkedIn, X, Instagram, TikTok, YouTube and Reddit (https://console.apify.com/account/integrations).
APIFY_TOKEN=
# GitHub, for contributions and repository stars; read access is enough.
GITHUB_TOKEN=
# Hard stop for creatorizz's own Apify spend per calendar month, in USD.
APIFY_MONTHLY_CAP_USD=10
# Local time of the automatic daily collection.
DAILY_AT=07:00
PORT=4410
# Address to listen on: 127.0.0.1 for this machine only, or the machine's address on a private
# network (e.g. its NetBird or Tailscale IP) to share the dashboard with that network.
HOST=127.0.0.1
# Read LinkedIn impressions daily in a visible Chrome window signed in with
# `npm run linkedin:login`. Off by default: LinkedIn does not allow automated access.
LINKEDIN_BROWSER=off
# Always-on Mac only: on = follow the tracked git branch (usually main) every minute, and
# update, check and restart when it moves (see README, "Auto-update").
AUTO_UPDATE=off
# Optional: keep data or the config somewhere else.
# CREATORIZZ_DATA=/path/to/data
# CREATORIZZ_CONFIG=/path/to/config.json
